# PatientGUI frontend — local environment
#
# Copy to `.env.local` (gitignored) and set per machine. Only VITE_-prefixed
# vars are exposed to the app (via import.meta.env).

# Absolute path to the decomposition model (.pkl) used by the decomposition
# panel. Machine-specific; leave unset to start with a blank field and enter it
# in the panel at runtime.
VITE_DECOMP_MODEL_PATH=
